# Copy to .env and restart `npm run dev`
# A chat subscription (Claude.ai / ChatGPT / Gemini app) is NOT an API key.
# You need a developer API key from the provider console.

# Optional: force one provider when multiple keys are set
# AI_PROVIDER=anthropic | openai | gemini

# --- Claude (Anthropic) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- ChatGPT (OpenAI) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Gemini (Google) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternate name also accepted
# GEMINI_MODEL=gemini-2.0-flash

# Precedence if AI_PROVIDER is unset:
#   1) ANTHROPIC_API_KEY  2) OPENAI_API_KEY  3) GEMINI_API_KEY / GOOGLE_API_KEY
