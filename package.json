{
  "name": "excel-stats-solver",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:ontario": "npx --yes tsx src/solvers/ontarioBlackout.test.ts",
    "test:apartment": "npx --yes tsx src/solvers/apartmentRental.test.ts",
    "test:toronto": "npx --yes tsx src/solvers/torontoWithin.test.ts",
    "test:paint-ci": "npx --yes tsx src/solvers/paintCi.test.ts",
    "test:stale": "npx --yes tsx src/solvers/staleAutofill.test.ts",
    "test:n-size": "npx --yes tsx src/solvers/nSize.test.ts",
    "test:local": "npm run test:ontario && npm run test:apartment && npm run test:toronto && npm run test:paint-ci && npm run test:stale && npm run test:n-size"
  },
  "dependencies": {
    "jstat": "^1.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~6.0.2",
    "vite": "^5.4.11"
  }
}
